# ── Snowflake ─────────────────────────────────────────────────────────────────
# Identifiant org-compte (ex. MYORG-MYACCOUNT)  https://mlh.link/snowflake-signup
SNOWFLAKE_ACCOUNT=MYORG-MYACCOUNT
SNOWFLAKE_USER=ECOABIDJAN_APP
# Authentification : mot de passe OU clé privée JWT (recommandé) OU token OAuth
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_TOKEN=
SNOWFLAKE_HOST=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ECOABIDJAN
SNOWFLAKE_SCHEMA=CORE

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Numéro de téléphone du compte administrateur (sans espaces, sans +225)
NEXT_PUBLIC_ADMIN_PHONE=
# CORS pour l'API (laisser * en dev, mettre l'URL du frontend en prod)
CORS_ORIGIN=*

# URL du backend Render (laisser vide si frontend et backend sont sur le même serveur)
# Ex. https://eco-abidjan-backend.onrender.com
NEXT_PUBLIC_API_URL=

# xAI Grok — analyse photo des signalements
# Obtenez votre clé sur https://console.x.ai
XAI_API_KEY=
